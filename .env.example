DATABASE_URL=postgresql+asyncpg://vv:vv@localhost:5432/video_virale
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=http://localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=video-virale
# Valeurs de développement : l'API logue un avertissement au démarrage tant qu'elles (ou les défauts du code,
# change-me / dev-secret) sont utilisées. À remplacer hors poste local (ex. SECRET_KEY=$(openssl rand -hex 32)).
# Compte admin créé par la migration 0015 (e-mail normalisé en minuscules) ; sans .env le mot de passe par défaut est
# change-me : à changer. PUBLIC_URL : base des liens envoyés par e-mail (vérification, mot de passe oublié).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
PUBLIC_URL=http://localhost:5173
SECRET_KEY=change-me-too
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
COMFYUI_URL=http://127.0.0.1:8188
FAKE_PROVIDERS=false
# dev : poste local. Toute autre valeur (ex. prod) : refus de démarrer avec ADMIN_PASSWORD / SECRET_KEY par défaut,
# cookie Secure (HTTPS) et /docs fermé.
APP_ENV=dev
